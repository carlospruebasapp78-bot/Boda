{
	admin off
	persist_config off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	root * /srv
	rewrite /invitacion /index.html
	encode gzip
	@html path / /index.html /invitacion
	header @html Cache-Control "no-cache"
	header /assets/* Cache-Control "public, max-age=86400"
	file_server
}
